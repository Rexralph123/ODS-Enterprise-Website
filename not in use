/* =====================================================
SUBMIT ORDER
===================================================== */

function submitBankOrder(){

    const items =
    getCheckoutItems();


    if(items.length === 0){

        alert(
            "Your cart is empty."
        );

        return;

    }


    currentOrderId =
    createOrderId();


    const order =
    calculateOrder(items);


    const orderData = {

        orderId:currentOrderId,

        customer:shippingInformation,

        paymentMethod:"Bank Transfer",

        paymentStatus:"Awaiting Verification",

        items:items.map(item => ({

            id:item.product.id,

            name:item.product.name,

            price:item.product.price,

            quantity:item.quantity

        })),

        subtotal:order.subtotal,

        shipping:order.shipping,

        total:order.total,

        createdAt:
        new Date().toISOString()

    };


    const previousOrders =

    JSON.parse(

        localStorage.getItem("odsOrders")

        || "[]"

    );


    previousOrders.push(orderData);


    localStorage.setItem(

        "odsOrders",

        JSON.stringify(previousOrders)

    );


    localStorage.setItem(

        "odsLastOrder",

        JSON.stringify(orderData)

    );


    saveCart({});


    checkoutStep = 3;


    renderCheckout();


    if(
        typeof updateCartCount === "function"
    ){

        updateCartCount();

    }


    window.scrollTo({

        top:0,

        behavior:"smooth"

    });

}



