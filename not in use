<script>

/* =====================================================
CHECKOUT STATE
===================================================== */

let checkoutStep = 1;

let selectedPayment = "bank";

let shippingInformation = {};

let currentOrderId = null;



/* =====================================================
ORDER ID
===================================================== */

function createOrderId(){

    return "ODS-" +
    new Date().getFullYear() +
    "-" +
    Math.floor(
        10000 + Math.random() * 90000
    );

}



/* =====================================================
GET CART ITEMS
===================================================== */

function getCheckoutItems(){

    const cart = getCart();

    return Object.keys(cart)

    .map(id => {

        const product = PRODUCTS.find(
            product =>
            product.id === Number(id)
        );


        if(!product){

            return null;

        }


        return {

            product,

            quantity:Number(cart[id])

        };

    })

    .filter(item =>

        item &&
        item.quantity > 0

    );

}



/* =====================================================
CALCULATE ORDER
===================================================== */

function calculateOrder(items){

    const subtotal = items.reduce(

        (total,item) =>

        total +
        (
            item.product.price *
            item.quantity
        ),

        0

    );


    const shipping =

    subtotal >= 100000

    ? 0

    : 5000;


    return {

        subtotal,

        shipping,

        total:
        subtotal + shipping

    };

}



/* =====================================================
ORDER SUMMARY
===================================================== */

function createOrderSummary(items,order){

    return `

    <div class="checkout-card">

        <h3>

            <i class="ti ti-receipt"></i>

            Order Summary

        </h3>


        ${items.map(item => `

        <div class="checkout-order-row">

            <div class="checkout-product">

                <img
                src="${item.product.image}"
                alt="${item.product.name}"
                class="checkout-product-img">


                <div class="checkout-product-info">

                    <strong>
                        ${item.product.name}
                    </strong>


                    <span>
                        Quantity: ${item.quantity}
                    </span>


                    ${
                        item.product.specs?.Condition

                        ? `

                        <small class="checkout-condition">

                            ${item.product.specs.Condition}

                        </small>

                        `

                        : ""
                    }

                </div>

            </div>


            <strong class="checkout-product-price">

                ${fmt(
                    item.product.price *
                    item.quantity
                )}

            </strong>

        </div>

        `).join("")}



        <div class="checkout-summary-details">

            <div class="checkout-order-row">

                <span>
                    Subtotal
                </span>

                <strong>
                    ${fmt(order.subtotal)}
                </strong>

            </div>


            <div class="checkout-order-row">

                <span>
                    Shipping
                </span>


                <strong class="${
                    order.shipping === 0
                    ? "free-shipping"
                    : ""
                }">

                    ${
                        order.shipping === 0
                        ? "FREE"
                        : fmt(order.shipping)
                    }

                </strong>

            </div>

        </div>


        <div class="checkout-total">

            <span>
                Total
            </span>

            <span>
                ${fmt(order.total)}
            </span>

        </div>

    </div>

    `;

}



/* =====================================================
CHECKOUT STEPS
===================================================== */

function createCheckoutSteps(){

    return `

    <div class="checkout-steps">


        <div class="
        step
        ${checkoutStep >= 1 ? "active" : ""}
        ${checkoutStep > 1 ? "done" : ""}
        ">

            <div class="step-circle">

                ${
                    checkoutStep > 1

                    ? '<i class="ti ti-check"></i>'

                    : "1"
                }

            </div>

            <div class="step-label">
                Shipping
            </div>

        </div>



        <div class="
        step
        ${checkoutStep >= 2 ? "active" : ""}
        ">

            <div class="step-circle">
                2
            </div>

            <div class="step-label">
                Payment
            </div>

        </div>



        <div class="
        step
        ${checkoutStep >= 3 ? "active" : ""}
        ">

            <div class="step-circle">
                3
            </div>

            <div class="step-label">
                Confirm
            </div>

        </div>


    </div>

    `;

}



/* =====================================================
RENDER CHECKOUT
===================================================== */

function renderCheckout(){

    const container =
    document.getElementById(
        "checkout-container"
    );


    const items =
    getCheckoutItems();



    if(
        items.length === 0 &&
        checkoutStep !== 3
    ){

        container.innerHTML = `

        <div class="empty-cart">

            <i class="ti ti-shopping-cart"></i>

            <h2>
                Your cart is empty
            </h2>

            <p>
                Add products before checking out.
            </p>

            <a
            class="btn-primary"
            href="index.html">

                Continue Shopping

            </a>

        </div>

        `;


        return;

    }



    const order =
    calculateOrder(items);


    const summary =
    createOrderSummary(
        items,
        order
    );


    const steps =
    createCheckoutSteps();



    /* SUCCESS */

    if(checkoutStep === 3){

        container.innerHTML = `

        <div class="success-screen">

            <div class="success-icon">

                <i class="ti ti-check"></i>

            </div>


            <h2>
                Order Submitted!
            </h2>


            <p>

                Your order has been submitted.

                Your payment will be verified
                before your order is confirmed.

            </p>


            <p>
                Order Reference
            </p>


            <div class="track-code">

                ${currentOrderId}

            </div>


            <br>


            <a
            class="btn-primary"
            href="index.html">

                Continue Shopping

            </a>

        </div>

        `;


        return;

    }



    /* SHIPPING */

    if(checkoutStep === 1){

        container.innerHTML =

        steps +

        `

        <div class="checkout-card">

            <h3>

                <i class="ti ti-truck-delivery"></i>

                Shipping Address

            </h3>


            <div class="form-row">

                <div class="form-group">

                    <label>
                        First Name
                    </label>

                    <input
                    id="firstName"
                    placeholder="First name">

                </div>


                <div class="form-group">

                    <label>
                        Last Name
                    </label>

                    <input
                    id="lastName"
                    placeholder="Last name">

                </div>

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>
                        Phone Number
                    </label>

                    <input
                    id="phone"
                    type="tel"
                    placeholder="+234">

                </div>


                <div class="form-group">

                    <label>
                        City
                    </label>

                    <input
                    id="city"
                    placeholder="Lagos">

                </div>

            </div>


            <div class="form-row single">

                <div class="form-group">

                    <label>
                        Street Address
                    </label>

                    <input
                    id="address"
                    placeholder="Enter delivery address">

                </div>

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>
                        State
                    </label>

                    <input
                    id="state"
                    placeholder="Lagos State">

                </div>


                <div class="form-group">

                    <label>
                        Postal Code
                    </label>

                    <input
                    id="postalCode"
                    placeholder="Optional">

                </div>

            </div>

        </div>


        ${summary}


        <button
        class="checkout-btn"
        onclick="continueToPayment()">

            Continue to Payment

            <i class="ti ti-arrow-right"></i>

        </button>

        `;

    }



    /* PAYMENT */

    else if(checkoutStep === 2){

        container.innerHTML =

        steps +

        `

        <div class="checkout-card">

            <h3>

                <i class="ti ti-credit-card"></i>

                Payment Method

            </h3>


            <div class="payment-options">

                <div class="
                payment-option selected
                ">

                    <i class="ti ti-building-bank"></i>

                    <div class="lbl">
                        Bank Transfer
                    </div>

                </div>

            </div>


            <div class="bank-transfer-box">

                <div class="bank-transfer-head">

                    <i class="ti ti-building-bank"></i>


                    <div>

                        <strong>
                            Bank Transfer
                        </strong>

                        <p>
                            Transfer the exact order total
                            to the account below.
                        </p>

                    </div>

                </div>


                <div class="bank-detail-row">

                    <span>
                        Bank
                    </span>

                    <strong>
                        OPay
                    </strong>

                </div>


                <div class="bank-detail-row">

                    <span>
                        Account Name
                    </span>

                    <strong>
                        O.D.S Enterprise
                    </strong>

                </div>


                <div class="bank-detail-row">

                    <span>
                        Account Number
                    </span>


                    <div>

                        <strong id="accountNumber">
                            6104090884
                        </strong>


                        <button
                        type="button"
                        class="copy-bank-btn"
                        onclick="copyAccountNumber()">

                            <i class="ti ti-copy"></i>

                            Copy

                        </button>

                    </div>

                </div>


                <div class="bank-detail-row">

                    <span>
                        Amount to Transfer
                    </span>


                    <strong>

                        ${fmt(order.total)}

                    </strong>

                </div>


                <div class="bank-notice">

                    <i class="ti ti-info-circle"></i>


                    <span>

                        Complete your bank transfer
                        before clicking
                        "I Have Made Payment".

                    </span>

                </div>

            </div>

        </div>


        ${summary}


        <button
        class="checkout-btn"
        onclick="submitBankOrder()">

            I Have Made Payment

            <i class="ti ti-shield-check"></i>

        </button>


        <button
        class="btn-outline"
        style="
        width:100%;
        margin-top:10px;
        "
        onclick="
        checkoutStep=1;
        renderCheckout();
        ">

            Back to Shipping

        </button>

        `;

    }

}



/* =====================================================
SHIPPING VALIDATION
===================================================== */

function continueToPayment(){

    const fields = [

        "firstName",
        "lastName",
        "phone",
        "city",
        "address",
        "state"

    ];


    const missingField = fields.find(id =>

        !document
        .getElementById(id)
        .value
        .trim()

    );


    if(missingField){

        alert(
            "Please complete all required shipping information."
        );

        return;

    }


    shippingInformation = {

        firstName:
        document.getElementById("firstName").value.trim(),

        lastName:
        document.getElementById("lastName").value.trim(),

        phone:
        document.getElementById("phone").value.trim(),

        city:
        document.getElementById("city").value.trim(),

        address:
        document.getElementById("address").value.trim(),

        state:
        document.getElementById("state").value.trim(),

        postalCode:
        document.getElementById("postalCode").value.trim()

    };


    checkoutStep = 2;


    renderCheckout();


    window.scrollTo({

        top:0,

        behavior:"smooth"

    });

}



